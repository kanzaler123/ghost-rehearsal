{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "labs/**/*.tsx", "scripts/mcp/**/*.ts", "tests/**/*.ts", "vite.config.ts", "vitest.config.ts", "playwright*.config.ts", "e2e/**/*.ts"]
}
