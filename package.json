{
  "name": "ghost-rehearsal",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-react-flow.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run tests --environment node",
    "test:browser": "playwright test",
    "test:browser:smoke": "playwright test e2e/smoke.spec.ts e2e/ui/welcome.spec.ts e2e/release/critical.spec.ts",
    "test:browser:webkit": "playwright test --config=playwright.webkit.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.schemas.json",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@xyflow/react": "12.12.1",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
